{
  "name": "milksu-desktop",
  "version": "26.927.3",
  "private": true,
  "description": "MilkSU Chromium desktop shell",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "electron": "43.8.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.milksu.app",
    "productName": "MilkSU",
    "asar": true,
    "directories": {
      "output": "../build/electron"
    },
    "files": [
      "main.cjs",
      "safe-console.cjs",
      "parse-url.cjs",
      "backend-runtime.cjs",
      "startup-environment.cjs",
      "preload.cjs",
      "account-session.cjs",
      "cdp-proxy.cjs",
      "channel-identity.cjs",
      "home-root.cjs",
      "build-tracking-view.cjs",
      "task-notify.cjs",
      "browser-view-attachment.cjs",
      "research-browser-network-policy.cjs",
      "research-browser-lifecycle.cjs",
      "update-manager.cjs",
      "update-artifacts.cjs",
      "linux-update-apply.cjs",
      "computer-use-permissions.cjs",
      "local-path.cjs",
      "linux-desktop.cjs",
      "window-chrome.cjs",
      "macos-screen-permission.cjs",
      "renderer-protocol.cjs",
      "renderer-reload.cjs",
      "companion-shell.cjs",
      "companion-preload.cjs",
      "companion-overlay-state.cjs",
      "companion-skin-host.cjs",
      "companion-skin.cjs",
      "package.json",
      "node_modules/ws/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "extraResources": [
      {
        "from": "../app/src/assets/milksu-logo.png",
        "to": "appicon.png"
      },
      {
        "from": "../app/dist",
        "to": "renderer"
      },
      {
        "from": "../runtime/dist/main.cjs",
        "to": "runtime/main.cjs"
      },
      {
        "from": "../runtime/dist/plugin-mcp.cjs",
        "to": "runtime/plugin-mcp.cjs"
      },
      {
        "from": "../runtime/src/envbroker/packages",
        "to": "envbroker/packages"
      },
      {
        "from": "../plugins/official",
        "to": "plugins/official"
      },
      {
        "from": "../browserextension",
        "to": "browserextension"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "../app/src/assets/milksu-logo.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "MilkSU \u4f7f\u7528\u5c4f\u5e55\u5f55\u5236\u8bfb\u53d6\u4f60\u660e\u786e\u9009\u62e9\u7684\u5916\u90e8 App \u7a97\u53e3\uff0c\u4f9b Coding Agent \u7684 Computer Use \u5b8c\u6210\u53ef\u89c1\u64cd\u4f5c\u3002"
      },
      "minimumSystemVersion": "12.0.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
